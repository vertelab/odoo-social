<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="utm_campaign_view_form">
        <field name="name">utm.campaign.view.form.inherit.social.crm</field>
        <field name="model">utm.campaign</field>
        <field name="inherit_id" ref="utm.utm_campaign_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Leads" name="social_crm_attribution" class="order-2"
                    groups="sales_team.group_sale_salesman">
                    <group>
                        <group string="Attributed Leads" name="attribution_crm">
                            <field name="crm_currency_id" invisible="1"/>
                            <field name="crm_lead_count"/>
                            <field name="crm_lead_won_count"/>
                            <field name="crm_expected_revenue"/>
                            <button name="action_redirect_to_social_marketing_leads"
                                type="object" string="View Leads" class="btn-link"
                                invisible="crm_lead_count == 0"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
