<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.social.planner.dashboard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="social_planner.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='social_marketing']" position="inside">
                <block title="Dashboard Alerts" name="social_dashboard_alerts_settings">
                    <setting string="Negative Sentiment Alert Threshold"
                             help="Trigger an alert when the share of negative sentiment exceeds this percentage over the last 30 days.">
                        <field name="social_dashboard_negative_sentiment_alert_threshold"/>
                    </setting>
                    <setting string="Compliance Rejection Alerts"
                             help="Notify approvers when a post is rejected by the policy compliance check.">
                        <field name="social_dashboard_compliance_alert_enabled"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
