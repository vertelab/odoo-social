<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="social_marketing_post_view_form">
        <field name="name">social_marketing.post.view.form.inherit.social.sale</field>
        <field name="model">social_marketing.post</field>
        <field name="inherit_id" ref="social_marketing.social_marketing_post_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_redirect_to_orders"
                    type="object" icon="fa-shopping-cart"
                    groups="sales_team.group_sale_salesman"
                    invisible="sale_order_count == 0">
                    <field name="sale_order_count" string="Orders" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <group name="social_sale_attribution" string="Sales Attribution"
                    groups="sales_team.group_sale_salesman"
                    invisible="state == 'draft'">
                    <field name="sale_currency_id" invisible="1"/>
                    <field name="sale_quotation_count"/>
                    <field name="sale_order_revenue"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
