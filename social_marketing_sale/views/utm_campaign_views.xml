<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="utm_campaign_view_form">
        <field name="name">utm.campaign.view.form.inherit.social.sale</field>
        <field name="model">utm.campaign</field>
        <field name="inherit_id" ref="utm.utm_campaign_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Orders" name="social_sale_attribution" class="order-3"
                    groups="sales_team.group_sale_salesman">
                    <group>
                        <group string="Attributed Orders" name="attribution_sale">
                            <field name="sale_currency_id" invisible="1"/>
                            <field name="sale_quotation_count"/>
                            <field name="sale_order_count"/>
                            <field name="sale_order_revenue"/>
                            <button name="action_redirect_to_confirmed_orders"
                                type="object" string="View Orders" class="btn-link"
                                invisible="sale_order_count == 0"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
