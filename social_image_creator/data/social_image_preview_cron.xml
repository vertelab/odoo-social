<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Daily backstop of the preview lifecycle (spec: image-templates):
         the render wizard unlinks a template's previous "(preview)"
         attachment before rendering a new one, and this cron removes any
         leftover preview attachments older than 24 hours, e.g. after a
         crash between those steps. -->
    <record id="ir_cron_social_image_preview_cleanup" model="ir.cron">
        <field name="name">Social Image: Clean Up Preview Attachments</field>
        <field name="model_id" ref="model_social_image_render_wizard"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup_previews()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
