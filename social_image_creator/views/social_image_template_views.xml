<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <record id="action_social_image_template" model="ir.actions.act_window">
        <field name="name">Image Templates</field>
        <field name="res_model">social.image.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first image template
            </p>
            <p>
                An image template is a reusable design with named size
                variants, for example a post and a story, and placeholders
                that fill in from your records. Create one with the New
                button, design it in the editor, then render images for
                posts and pages from it.
            </p>
        </field>
    </record>

    <record id="social_image_template_view_list" model="ir.ui.view">
        <field name="name">social.image.template.view.list</field>
        <field name="model">social.image.template</field>
        <field name="arch" type="xml">
            <list string="Image Templates">
                <field name="name"/>
                <field name="model_id"/>
                <field name="width"/>
                <field name="height"/>
                <field name="placeholder_ids" widget="many2many_tags" string="Placeholders"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="social_image_template_view_search" model="ir.ui.view">
        <field name="name">social.image.template.view.search</field>
        <field name="model">social.image.template</field>
        <field name="arch" type="xml">
            <search string="Image Templates">
                <field name="name"/>
                <field name="model_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="social_image_template_view_form" model="ir.ui.view">
        <field name="name">social.image.template.view.form</field>
        <field name="model">social.image.template</field>
        <field name="arch" type="xml">
            <form string="Image Template">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="model_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="width" readonly="1"/>
                            <field name="height" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Variants" colspan="2">
                        <field name="variants_summary" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Placeholders" colspan="2">
                        <field name="placeholder_ids">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="label"/>
                            </list>
                        </field>
                    </group>
                    <group string="Design" colspan="2">
                        <field name="scene_json" widget="social_image_editor" class="o_image_template_scene_json"/>
                        <field name="svg_master" widget="image" class="o_image_template_svg_preview"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="menu_social_image_studio" model="ir.ui.menu">
        <field name="name">Image Studio</field>
        <field name="parent_id" ref="menu_social_marketing_global"/>
        <field name="sequence">25</field>
        <field name="groups" eval="[(4, ref('social_marketing.group_social_marketing_user')), (4, ref('social_marketing.group_social_marketing_manager'))]"/>
    </record>

    <record id="menu_social_image_template" model="ir.ui.menu">
        <field name="name">Image Templates</field>
        <field name="parent_id" ref="menu_social_image_studio"/>
        <field name="action" ref="action_social_image_template"/>
        <field name="sequence">10</field>
    </record>

    <record id="action_social_image_size" model="ir.actions.act_window">
        <field name="name">Image Sizes</field>
        <field name="res_model">social.image.size</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="social_image_size_view_list" model="ir.ui.view">
        <field name="name">social.image.size.view.list</field>
        <field name="model">social.image.size</field>
        <field name="arch" type="xml">
            <list string="Image Sizes">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="width"/>
                <field name="height"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="social_image_size_view_form" model="ir.ui.view">
        <field name="name">social.image.size.view.form</field>
        <field name="model">social.image.size</field>
        <field name="arch" type="xml">
            <form string="Image Size">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="width"/>
                        <field name="height"/>
                        <field name="active"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="menu_social_image_size" model="ir.ui.menu">
        <field name="name">Image Sizes</field>
        <field name="parent_id" ref="menu_social_marketing_configuration"/>
        <field name="action" ref="action_social_image_size"/>
        <field name="sequence">45</field>
    </record>

    <record id="action_social_image_template_sync_bulk_actions" model="ir.actions.server">
        <field name="name">Sync Bulk Creation Actions</field>
        <field name="model_id" ref="model_social_image_template"/>
        <field name="binding_model_id" ref="model_social_image_template"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_bulk_actions()</field>
        <field name="groups_id" eval="[(4, ref('social_marketing.group_social_marketing_user'))]"/>
    </record>

</data>
</odoo>
