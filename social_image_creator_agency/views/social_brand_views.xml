<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Brand kit on the brand form: color palette + uploaded fonts.
         The base brand form (social_marketing_agency) already carries a
         Brand Kit page with palette, colours, fonts, logos and assets;
         this module adds the render-service download button to the font
         rows there. The font model is owned by social_marketing_agency
         (fonts are ``font_file`` with a ``role``), so no page is added
         here. -->
    <record id="view_social_brand_form_brand_kit" model="ir.ui.view">
        <field name="name">social.brand.form.brand_kit</field>
        <field name="model">social.brand</field>
        <field name="inherit_id" ref="social_marketing_agency.view_social_brand_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='font_ids']/list/field[@name='font_file']"
                   position="after">
                <button name="action_download_for_render_service"
                        type="object" icon="fa-download"
                        title="Download for render service (copy into render_service/fonts/)"/>
            </xpath>
        </field>
    </record>
</odoo>
