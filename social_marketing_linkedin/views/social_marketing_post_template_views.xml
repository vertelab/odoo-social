<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <record id="social_post_template_view_form" model="ir.ui.view">
        <field name="name">social.post.template.view.form.inherit.social.linkedin</field>
        <field name="model">social_marketing.post.template</field>
        <field name="priority">15</field>
        <field name="inherit_id" ref="social_marketing.social_marketing_post_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='platform_ids']" position="after">
                <group string="LinkedIn Settings" name="linkedin_settings" colspan="2"
                      invisible="not is_linkedin">
                    <group string="Audience &amp; Comments">
                        <field name="is_linkedin" invisible="1"/>
                        <field name="linkedin_audience"/>
                        <field name="linkedin_group_urn"
                               invisible="linkedin_audience != 'group'"
                               placeholder="urn:li:group:..."/>
                        <field name="linkedin_comments"/>
                        <field name="linkedin_brand_partnership"/>
                    </group>
                    <group string="Media">
                        <field name="linkedin_media_type"/>
                        <field name="linkedin_image_width"/>
                        <field name="linkedin_image_height"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//group[@name='previews_placeholder']" position="inside">
                <field name="display_linkedin_preview" invisible="1" />
                <field name="linkedin_preview" nolabel="1" colspan="2" widget="social_marketing_post_preview" media_type="linkedin"
                    readonly="1"
                    invisible="not display_linkedin_preview"
                    class="o_social_preview_wrapper m-0 px-4 py-4 bg-200"/>
            </xpath>
        </field>
    </record>
</data>
</odoo>
