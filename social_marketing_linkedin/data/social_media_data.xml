<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="social_media_linkedin" model="social_marketing.media">
            <field name="name">LinkedIn</field>
            <field name="media_type">linkedin</field>
            <field name="media_description">Manage your LinkedIn account and schedule posts</field>
            <field name="max_post_length">3000</field>
            <field name="image" type="base64" file="social_marketing_linkedin/static/src/img/linkedin.svg"/>
        </record>

        <record id="stream_type_linkedin_company_post" model="social_marketing.stream.type">
            <field name="name">Posts</field>
            <field name="stream_type">linkedin_company_post</field>
            <field name="media_id" ref="social_media_linkedin"/>
        </record>

        <record id="stream_type_linkedin_company_page" model="social_marketing.stream.type">
            <field name="name">Company Page</field>
            <field name="stream_type">linkedin_company_page</field>
            <field name="media_id" ref="social_media_linkedin"/>
        </record>

        <record id="stream_type_linkedin_feed" model="social_marketing.stream.type">
            <field name="name">LinkedIn Feed</field>
            <field name="stream_type">linkedin_feed</field>
            <field name="media_id" ref="social_media_linkedin"/>
        </record>
    </data>
</odoo>
