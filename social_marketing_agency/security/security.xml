<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ── Customer groups ─────────────────────────────────────── -->
        <record id="group_social_customer" model="res.groups">
            <field name="name">Social: Customer (Portal)</field>
        </record>

        <record id="group_social_customer_approver" model="res.groups">
            <field name="name">Social: Customer Approver</field>
            <field name="implied_ids" eval="[(4, ref('group_social_customer'))]"/>
        </record>

        <record id="group_social_customer_editor" model="res.groups">
            <field name="name">Social: Customer Editor</field>
            <field name="implied_ids" eval="[(4, ref('group_social_customer_approver'))]"/>
        </record>

        <!-- ── Agency brand user (internal) ────────────────────────── -->
        <record id="group_social_agency_brand_user" model="res.groups">
            <field name="name">Social: Agency Brand User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>

    <!-- ──────────────────────────────────────────────────────────────
         Record rules — customer users see only data of brands whose
         customer partner is their own commercial partner.
         Approver: read only. Editor: read + write on own brands.
         Agency-internal records (brand_id = False) are never matched
         (no OR branch) so they stay invisible to customer users.
         ────────────────────────────────────────────────────────────── -->

    <!-- social.agency.document -->
    <record id="rule_social_agency_document_customer_read" model="ir.rule">
        <field name="name">Underlag: customer read own brands</field>
        <field name="model_id" ref="model_social_agency_document"/>
        <field name="domain_force">['|', ('brand_id', '=', False), ('brand_id.partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_social_customer_approver')), (4, ref('group_social_customer_editor'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="rule_social_agency_document_customer_write" model="ir.rule">
        <field name="name">Underlag: customer editor write own brands</field>
        <field name="model_id" ref="model_social_agency_document"/>
        <field name="domain_force">[('brand_id.partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_social_customer_editor'))]"/>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

