<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban root: brand selection as the app's first page -->
    <record id="view_social_brand_kanban" model="ir.ui.view">
        <field name="name">social.brand.kanban</field>
        <field name="model">social.brand</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="color"/>
                <field name="logo"/>
                <field name="document_count"/>
                <field name="partner_id"/>
                <t t-name="card">
                    <div class="oe_kanban_global_click">
                        <div class="o_kanban_image" t-attf-style="background-color: #{record.color or '#7c7bad'};">
                            <t t-if="record.logo.raw_value">
                                <img t-att-src="image_data_uri(record.logo.raw_value)" class="img-fluid" alt="Brand logo"/>
                            </t>
                            <t t-else="">
                                <i class="fa fa-building-o text-white"/>
                            </t>
                        </div>
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                            <div><field name="partner_id"/></div>
                            <div class="text-muted">
                                <i class="fa fa-file-text-o"/> <field name="document_count"/> underlag
                            </div>
                        </div>
                        <div class="oe_kanban_footer">
                            <button name="action_set_focus" type="object"
                                    string="Open Workspace" class="btn btn-primary btn-sm"/>
                            <button name="action_open_dashboard" type="object"
                                    string="Dashboard" class="btn btn-secondary btn-sm"/>
                        </div>
                        <div class="oe_kanban_footer">
                            <div class="btn-group" role="group" aria-label="Brand sections">
                                <button name="action_view_social_accounts" type="object"
                                        class="btn btn-sm btn-outline-secondary" title="Social Accounts"
                                        icon="fa-users"/>
                                <button name="action_view_policies" type="object"
                                        class="btn btn-sm btn-outline-secondary" title="Policies"
                                        icon="fa-legal"/>
                                <button name="action_view_streams" type="object"
                                        class="btn btn-sm btn-outline-secondary" title="Flows"
                                        icon="fa-rss"/>
                                <button name="action_view_competitors" type="object"
                                        class="btn btn-sm btn-outline-secondary" title="Competitors"
                                        icon="fa-line-chart"/>
                                <button name="action_view_listening_topics" type="object"
                                        class="btn btn-sm btn-outline-secondary" title="Listening"
                                        icon="fa-search"/>
                            </div>
                        </div>
                    </div>
                </t>
            </kanban>
        </field>
    </record>

    <record id="view_social_brand_list" model="ir.ui.view">
        <field name="name">social.brand.list</field>
        <field name="model">social.brand</field>
        <field name="arch" type="xml">
            <list string="Brands">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="customer_edit_enabled"/>
                <field name="document_count"/>
            </list>
        </field>
    </record>

    <record id="view_social_brand_search" model="ir.ui.view">
        <field name="name">social.brand.search</field>
        <field name="model">social.brand</field>
        <field name="arch" type="xml">
            <search string="Brands">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="group_by_partner" string="Customer"
                        context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_social_brand_form" model="ir.ui.view">
        <field name="name">social.brand.form</field>
        <field name="model">social.brand</field>
        <field name="arch" type="xml">
            <form string="Brand">
                <header>
                    <button name="action_open_dashboard" type="object"
                            string="Open Dashboard" class="btn-primary"/>
                    <button name="action_sync_dashboard_users" type="object"
                            string="Sync Dashboard Users"/>
                    <button name="action_set_focus" type="object"
                            string="Open Workspace"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <field name="document_count" widget="statinfo"/>
                                <span>Underlag</span>
                            </div>
                        </button>
                        <button name="action_view_listening_topics" type="object"
                                class="oe_stat_button" icon="fa-line-chart">
                            <div class="o_stat_info">
                                <field name="trend_report_label" widget="statinfo"/>
                                <span>Trend Reports</span>
                            </div>
                        </button>
                        <button name="action_view_credentials" type="object"
                                class="oe_stat_button" icon="fa-key">
                            <div class="o_stat_info">
                                <field name="credential_count" widget="statinfo"/>
                                <span>Credentials</span>
                            </div>
                        </button>
                    </div>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="color"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="customer_edit_enabled"/>
                            <field name="default_policy_id"/>
                            <field name="dashboard_id" readonly="1"/>
                        </group>
                        <group string="Publishing" name="brand_publishing">
                            <field name="publishing_paused"/>
                            <field name="publishing_paused_reason"
                                   invisible="not publishing_paused"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="not publishing_paused">
                        Publishing is paused for this brand. Nothing goes out
                        to any social network until this is switched off.
                        Other brands are unaffected.
                    </div>
                    <notebook>
                        <page string="Underlag" name="underlag">
                            <field name="document_ids" readonly="0">
                                <list>
                                    <field name="name"/>
                                    <field name="type_id"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Brand Kit" name="brand_kit">
                            <group string="Colors">
                                <field name="color_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="role"/>
                                        <field name="hex"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Fonts">
                                <field name="font_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="role"/>
                                        <field name="filename"/>
                                        <field name="font_file" filename="filename"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Logos">
                                <field name="logo_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="variant"/>
                                        <field name="image" widget="image" options="{'size': [64, 64]}"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Assets">
                                <field name="asset_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="asset_type"/>
                                        <field name="filename"/>
                                        <field name="file" filename="filename"/>
                                        <field name="description" optional="hide"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_social_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">social.brand</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Select a brand to open its workspace.
            </p>
            <p>Brands scope all customer data: underlag, policies, templates,
               listening topics, streams, accounts and dashboards.</p>
        </field>
    </record>
</odoo>
