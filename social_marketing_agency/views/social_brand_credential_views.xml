<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Social Brand Credential - List View -->
    <record id="view_social_brand_credential_list" model="ir.ui.view">
        <field name="name">social.brand.credential.list</field>
        <field name="model">social.brand.credential</field>
        <field name="arch" type="xml">
            <list string="Brand Credentials">
                <field name="brand_id"/>
                <field name="platform"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Social Brand Credential - Form View -->
    <record id="view_social_brand_credential_form" model="ir.ui.view">
        <field name="name">social.brand.credential.form</field>
        <field name="model">social.brand.credential</field>
        <field name="arch" type="xml">
            <form string="Brand Credential">
                <header>
                    <button name="action_write_env_file" type="object"
                            string="Write .env File" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="brand_id"/>
                            <field name="platform"/>
                            <field name="active"/>
                        </group>
                        <group string="X / Twitter" name="x_group">
                            <field name="auth_token"/>
                            <field name="ct0"/>
                        </group>
                        <group string="Bluesky" name="bluesky_group">
                            <field name="bsky_handle"/>
                            <field name="bsky_app_password"/>
                        </group>
                        <group string="API Keys / Other" name="keys_group">
                            <field name="api_key"/>
                            <field name="username"/>
                            <field name="password"/>
                            <field name="truthsocial_token"/>
                        </group>
                    </group>
                    <group string="Usage">
                        <p class="text-muted mb-0">
                            Credentials are written to a per-brand last30days config
                            directory (<code>LAST30DAYS_CONFIG_DIR</code>) as a
                            0600 <code>.env</code> file. The research engine then
                            uses this brand's logged-in accounts without
                            cross-brand leakage.
                        </p>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Social Brand Credential - Action -->
    <record id="action_social_brand_credential" model="ir.actions.act_window">
        <field name="name">Brand Credentials</field>
        <field name="res_model">social.brand.credential</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
