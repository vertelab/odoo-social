<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Agency user: brand assignment -->
    <record id="view_res_users_brands" model="ir.ui.view">
        <field name="name">res.users.brands</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <field name="brand_ids" widget="many2many_tags"
                       groups="social_marketing.group_social_marketing_manager"
                       placeholder="Brands this user works with..."/>
            </xpath>
        </field>
    </record>
</odoo>
