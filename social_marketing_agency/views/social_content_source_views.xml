<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_social_content_source_list" model="ir.ui.view">
        <field name="name">social.content.source.list</field>
        <field name="model">social.content.source</field>
        <field name="arch" type="xml">
            <list string="Content Sources">
                <field name="name"/>
                <field name="brand_id"/>
                <field name="model_id"/>
                <field name="interval_type"/>
                <field name="weekday" optional="show"/>
                <field name="day_of_month" optional="hide"/>
                <field name="time_of_day" widget="float_time"/>
                <field name="last_run"/>
                <field name="next_run"/>
                <field name="log_count" string="Generated"/>
            </list>
        </field>
    </record>

    <record id="view_social_content_source_form" model="ir.ui.view">
        <field name="name">social.content.source.form</field>
        <field name="model">social.content.source</field>
        <field name="arch" type="xml">
            <form string="Content Source">
                <header>
                    <button name="action_generate_now" type="object"
                            string="Generate Draft Now" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_generated_posts" type="object"
                                class="oe_stat_button" icon="fa-newspaper-o">
                            <field name="log_count" widget="statinfo" string="Generated"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. One product every Monday"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not unbound_token_warning">
                        The post template uses tokens no data binding
                        resolves for this model:
                        <field name="unbound_token_warning" class="oe_inline"/>.
                        Add a data binding for each of them on the post
                        template, otherwise generated posts come out empty.
                    </div>
                    <group>
                        <group string="What to post">
                            <field name="brand_id"/>
                            <field name="model_id"/>
                            <field name="model_name" invisible="1"/>
                            <field name="domain" widget="domain"
                                   options="{'model': 'model_name'}"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Schedule">
                            <field name="interval_type"/>
                            <field name="weekday"
                                   invisible="interval_type != 'weekly'"
                                   required="interval_type == 'weekly'"/>
                            <field name="day_of_month"
                                   invisible="interval_type != 'monthly'"/>
                            <field name="time_of_day" widget="float_time"/>
                            <field name="last_run"/>
                            <field name="next_run"/>
                        </group>
                        <group string="How to post">
                            <field name="post_template_id"/>
                            <field name="image_template_id"/>
                            <field name="utm_campaign_id"/>
                        </group>
                        <group string="Where to post">
                            <field name="account_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Generated Posts" name="log">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="res_model"/>
                                    <field name="res_id"/>
                                    <field name="post_id"/>
                                    <field name="cycle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_social_content_source_search" model="ir.ui.view">
        <field name="name">social.content.source.search</field>
        <field name="model">social.content.source</field>
        <field name="arch" type="xml">
            <search string="Content Sources">
                <field name="name"/>
                <field name="brand_id"/>
                <field name="model_id"/>
                <filter name="filter_active" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_brand" string="Brand"
                            context="{'group_by': 'brand_id'}"/>
                    <filter name="group_interval" string="Interval"
                            context="{'group_by': 'interval_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_social_content_source" model="ir.actions.act_window">
        <field name="name">Content Sources</field>
        <field name="res_model">social.content.source</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_social_content_source_search"/>
    </record>

    <record id="view_social_content_source_log_list" model="ir.ui.view">
        <field name="name">social.content.source.log.list</field>
        <field name="model">social.content.source.log</field>
        <field name="arch" type="xml">
            <list string="Generated Posts" create="false">
                <field name="date"/>
                <field name="source_id"/>
                <field name="brand_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="post_id"/>
                <field name="cycle"/>
            </list>
        </field>
    </record>

    <!-- Post reuse pool fields -->
    <record id="view_social_marketing_post_evergreen" model="ir.ui.view">
        <field name="name">social.marketing.post.evergreen</field>
        <field name="model">social_marketing.post</field>
        <field name="inherit_id" ref="social_marketing_agency.view_social_marketing_post_brand"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='brand_id']" position="after">
                <field name="is_evergreen"/>
                <field name="reuse_cooldown_days" invisible="not is_evergreen"/>
                <field name="last_reused_date" invisible="not is_evergreen"/>
            </xpath>
        </field>
    </record>

</odoo>
