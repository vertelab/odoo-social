<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <record id="social_marketing_post_template_action" model="ir.actions.act_window">
        <field name="name">Social Post Templates</field>
        <field name="res_model">social_marketing.post.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="social_marketing_post_template_view_tree" model="ir.ui.view">
        <field name="name">social_marketing.post.template.view.tree</field>
        <field name="model">social_marketing.post.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="message_plain"/>
            </list>
        </field>
    </record>

    <record id="social_marketing_post_template_view_form" model="ir.ui.view">
        <field name="name">social_marketing.post.template.view.form</field>
        <field name="model">social_marketing.post.template</field>
        <field name="arch" type="xml">
            <form string="Social Post Template" class="o_social_marketing_post_view_form">
                <sheet>
                    <group>
                        <!-- LEFT column: platform, bridge settings, content -->
                        <group string="Your Post" name="social_post_global" class="o_social_marketing_post_form_content">
                            <field name="has_active_accounts" invisible="1" />
                            <field name="account_ids" options="{'no_create': True}" string="Post on" widget="many2many_checkboxes"
                                 invisible="not has_active_accounts" />
                            <div colspan="2" class="alert alert-info o_social_marketing_post_no_accounts_available" role="alert"
                                invisible="has_active_accounts">
                                <p><a href="/odoo/action-social_marketing.action_social_marketing_media">Link social accounts</a> before posting.</p>
                            </div>
                            <field name="platform_ids" widget="many2many_tags"/>
                            <!-- LinkedIn / Instagram settings are inserted here by the bridge modules -->
                            <field name="message" widget="html" class="o_social_marketing_post_message_wrapper"
                                placeholder="Write a message or upload an image"
                                readonly="not has_active_accounts"
                                invisible="is_split_per_media"/>
                            <field name="image_ids" widget="many2many_binary"
                                class="o_social_marketing_post_form_attachments"
                                invisible="is_split_per_media"/>
                        </group>
                        <!-- RIGHT column: live post preview -->
                        <group string="Preview" name="previews_placeholder" class="o_social_marketing_post_preview_group m-0"
                            invisible="is_split_per_media">
                            <div>
                                <div class="o_social_marketing_post_preview_container bg-200 pt-3"
                                    invisible="not message and not image_ids">
                                    <h2 class="w-100 text-center mb-2">Posts Preview</h2>
                                    <div class="o_social_marketing_post_preview d-flex justify-content-center">
                                        <field name="message" widget="social_marketing_post_preview"
                                               nolabel="1" readonly="1"/>
                                    </div>
                                    <div class="o_social_marketing_post_preview_images d-flex justify-content-center flex-wrap">
                                        <field name="preview_images_html" widget="html" nolabel="1" readonly="1"/>
                                    </div>
                                    <div class="d-block mx-auto text-center"
                                        invisible="media_count == 1">
                                        <field name="is_split_per_media" widget="social_post_split_per_media"/>
                                    </div>
                                </div>
                                <div class="o_social_marketing_post_empty_preview overflow-hidden o_view_nocontent bg-100 rounded-end d-flex flex-column"
                                    invisible="message or image_ids">
                                    <div class="o_nocontent_help">
                                        <p class="o_view_nocontent_smiling_face mt-3">
                                            Preview your post
                                        </p>
                                        <p>
                                            Before posting, links will be converted to be trackable.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </group>
                    </group>
                    <notebook name="media_customization" invisible="not is_split_per_media"/>
                </sheet>
            </form>
        </field>
    </record>
</data>
</odoo>
