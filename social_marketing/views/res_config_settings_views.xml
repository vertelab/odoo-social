<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_social_marketing_global_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'social_marketing', 'bin_size': False}</field>
    </record>

    <record id="menu_social_marketing_global_settings" model="ir.ui.menu">
        <field name="name">Settings</field>
        <field name="action" ref="action_social_marketing_global_settings" />
    </record>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.social</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <t groups="social_marketing.group_social_marketing_manager">
                    <app data-string="Social Media" string="Social Marketing" name="social_marketing" groups="base.group_no_one">
                        <block title="Demo Mode" name="social_media_demo">
                            <setting help="Enable this option and load demo data to test the social module. This must never be used on a production database!">
                                <field name="module_social_marketing_demo"/>
                            </setting>
                        </block>
                        <block title="Developer Accounts" help="Use your own Developer Accounts on our Social app. Those credentials are provided in the developer section of your professional social media account." class="o_social_marketing_developer_settings"></block>
                                                <block title="Background Jobs">
                                <setting id="social_bg_jobs_display" string="Cron-jobb">
                                    <field name="social_marketing_cron_line_ids" widget="one2many">
                                        <form>
                                            <group>
                                                <field name="cron_id" readonly="1" force_save="1"/>
                                                <field name="cron_name" readonly="1"/>
                                                <field name="cron_active"/>
                                                <field name="cron_interval_number"/>
                                                <field name="cron_interval_type"/>
                                                <field name="cron_lastcall" readonly="1"/>
                                                <field name="cron_failure_count" readonly="1"/>
                                                <field name="cron_code" readonly="1"/>
                                                <button name="action_run_now" type="object"
                                                        string="Kör nu" icon="fa-play"/>
                                            </group>
                                        </form>
                                        <list>
                                            <field name="cron_name"/>
                                            <field name="cron_active"/>
                                            <field name="cron_interval_number"/>
                                            <field name="cron_interval_type"/>
                                            <field name="cron_lastcall"/>
                                            <field name="cron_failure_count"/>
                                        </list>
                                    </field>
                                </setting>
                            </block>
                        </app>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
