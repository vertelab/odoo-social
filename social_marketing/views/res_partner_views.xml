<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- LinkedIn connection fields on res.partner -->
        <record id="view_res_partner_form_social_marketing_linkedin" model="ir.ui.view">
            <field name="name">res.partner.form.social.marketing.linkedin</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="LinkedIn" name="social_linkedin" groups="social_marketing.group_social_marketing_user">
                        <group>
                            <group name="linkedin_main">
                                <field name="linkedin_url" widget="url" placeholder="https://www.linkedin.com/company/..."/>
                            </group>
                            <group name="linkedin_ids">
                                <field name="linkedin_urn"/>
                                <field name="linkedin_id"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
