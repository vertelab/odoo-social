<?xml version='1.0' encoding='utf-8'?>
<odoo noupdate="1">
    <record id="ir_cron_post_scheduled" model="ir.cron">
        <field name="name">Social: Publish Scheduled Posts</field>
        <field name="model_id" ref="model_social_marketing_post"/>
        <field name="state">code</field>
        <field name="code">model._cron_publish_scheduled()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_refresh_statistics" model="ir.cron">
        <field name="name">Social: Refresh Statistics and Snapshots</field>
        <field name="model_id" ref="model_social_marketing_account"/>
        <field name="state">code</field>
        <field name="code">model.refresh_statistics()
model.env['social_marketing.live.post'].refresh_statistics()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_backfill_statistics" model="ir.cron">
        <field name="name">Social: Backfill Historical Statistics</field>
        <field name="model_id" ref="model_social_marketing_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_backfill_statistics()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="False"/>
    </record>
</odoo>
