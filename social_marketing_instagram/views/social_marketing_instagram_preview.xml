<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <template id="instagram_preview" t-name="Instagram Preview">
        <div class="o_social_marketing_preview o_social_marketing_instagram_preview">
            <div class="shadow-sm bg-white px-3 overflow-hidden border rounded py-4">
                <div class="o_social_marketing_preview_header d-flex align-content-between my-3">
                    <span class="o_social_marketing_preview_icon_wrapper overflow-hidden me-2">
                        <i class="fa fa-instagram text-white fa-2x"/>
                    </span>
                    <div class="o_social_marketing_preview_author">
                        <div><b>Instagram Post</b></div>
                        <a t-if="live_post_link" t-attf-href="#{live_post_link}" target="blank"><small t-esc="published_date"/></a>
                        <t t-else=""><small t-esc="published_date"/></t>
                    </div>
                </div>
                <div class="o_social_marketing_preview_message">
                    <div t-esc="message"></div>
                </div>
                <div class="o_social_marketing_stream_post_image d-flex mx-n3 overflow-hidden">
                    <t t-foreach="image_urls" t-as="image_url">
                        <a t-if="image_url_index == 1 and len(image_urls) > 2" class="o_social_marketing_stream_post_image_more position-relative d-flex ms-1">
                            <img t-att-src="image_url" alt="Post Image" />
                            <div class="o_social_marketing_stream_post_image_more_overlay d-flex align-items-center h-100 w-100 text-white justify-content-center position-absolute h1 m-0" style="user-select: none;">
                                +<t t-esc="len(image_urls) - 2"/>
                            </div>
                        </a>
                        <a t-elif="image_url_index &lt; 2" class="w-100">
                            <img t-att-src="image_url" alt="Post Image" />
                        </a>
                    </t>
                </div>
                <div class="o_social_marketing_instagram_preview_actions d-flex justify-content-between px-2 py-2 mt-2 border-top text-muted">
                    <span><i class="fa fa-heart me-1"/> Like</span>
                    <span><i class="fa fa-comment me-1"/> Comment</span>
                    <span><i class="fa fa-paper-plane me-1"/> Send</span>
                </div>
            </div>
        </div>
    </template>
</data>
</odoo>
