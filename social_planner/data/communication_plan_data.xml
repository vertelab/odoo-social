<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Demo Plan: Summer Campaign 2026 -->
    <record id="demo_plan_summer_2026" model="communication.plan">
        <field name="name">Summer Campaign 2026 — Seasonal Launch</field>
        <field name="description">
            Multi-channel summer campaign launching new seasonal product line.
            Target: young professionals 25-40 in urban areas.
        </field>
        <field name="policy_id" ref="demo_policy_b2c_retail"/>
        <field name="start_date" eval="(datetime.today() - timedelta(days=7)).strftime('%Y-%m-%d')"/>
        <field name="end_date" eval="(datetime.today() + timedelta(days=21)).strftime('%Y-%m-%d')"/>
        <field name="goal">
            - Increase social media reach by 30%
            - Generate 200+ leads through social channels
            - Achieve 5% engagement rate on campaign posts
            - Drive 5000+ clicks to campaign landing page
        </field>
        <field name="target_audience">
            Primary: Young professionals aged 25-40, urban lifestyle, tech-savvy, sustainability-conscious.
            Secondary: Fashion-forward millennials who follow seasonal trends.
        </field>
        <field name="state">active</field>
        <field name="color">4</field>
    </record>

    <!-- Plan Lines for Summer Campaign -->
    <record id="demo_plan_line_1" model="communication.plan.line">
        <field name="plan_id" ref="demo_plan_summer_2026"/>
        <field name="sequence">10</field>
        <field name="channel">instagram</field>
        <field name="content_type">story</field>
        <field name="date" eval="(datetime.today() - timedelta(days=3)).strftime('%Y-%m-%d')"/>
        <field name="time">9.0</field>
        <field name="theme">Teaser — Sneak peek of summer collection</field>
        <field name="status">completed</field>
    </record>

    <record id="demo_plan_line_2" model="communication.plan.line">
