<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Communication Policy - Tree View -->
    <record id="view_communication_policy_tree" model="ir.ui.view">
        <field name="name">communication.policy.tree</field>
        <field name="model">communication.policy</field>
        <field name="arch" type="xml">
            <list string="Communication Policies" decoration-warning="state == 'draft'" decoration-muted="state == 'archived'">
                <field name="name"/>
                <field name="version" widget="badge"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'draft'"
                       decoration-muted="state == 'archived'"/>
                <field name="plan_count" string="Plans"/>
                <field name="owner_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Communication Policy - Form View -->
    <record id="view_communication_policy_form" model="ir.ui.view">
        <field name="name">communication.policy.form</field>
        <field name="model">communication.policy</field>
        <field name="arch" type="xml">
            <form string="Communication Policy">
                <header>
                    <button name="action_draft" string="Set Draft" type="object"
                            invisible="state not in ['active', 'archived']" class="btn-secondary"/>
                    <button name="action_activate" string="Activate" type="object"
                            invisible="state not in ['draft', 'archived']" class="btn-primary"/>
                    <button name="action_archive" string="Archive" type="object"
                            invisible="state not in ['draft', 'active']" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,archived"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Policy Name" required="1"/>
                        </h1>
                        <group name="metadata">
                            <field name="version" widget="badge"/>
                            <field name="owner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </div>

                    <notebook>
                        <!-- Tab 1: Tonalitet & Röst -->
                        <page string="Tone &amp; Voice" name="tone_voice">
                            <group name="tone_voice_group" string="Tone of Voice">
                                <field name="tone_of_voice" nolabel="1"
                                       placeholder="Describe the desired tone of voice..."/>
                            </group>
                            <group name="brand_voice_group" string="Brand Voice Guidelines">
                                <field name="brand_voice_guidelines" nolabel="1"
                                       placeholder="Specific words to use/avoid, language rules, style guide..."/>
                            </group>
                            <group name="description_group" string="Description">
                                <field name="description" nolabel="1"
                                       placeholder="Overall description of the policy's purpose..."/>
                            </group>
                        </page>

                        <!-- Tab 2: Publiceringsregler -->
                        <page string="Publication Rules" name="publication_rules">
                            <group name="frequency_group" string="Posting Frequency Limits">
                                <group>
                                    <field name="posting_frequency_max_daily"/>
                                    <field name="posting_frequency_max_weekly"/>
                                </group>
                            </group>
                            <group name="hashtag_group" string="Hashtag Policy">
                                <field name="hashtag_policy" nolabel="1"
                                       placeholder="Hashtag rules, branded hashtags, max per post..."/>
                            </group>
                            <group name="image_group" string="Image Guidelines">
                                <field name="image_guidelines" nolabel="1"
                                       placeholder="Format, size, brand colors, alt-text requirements..."/>
                            </group>
                            <group name="prohibited_group" string="Prohibited Content">
                                <field name="prohibited_content" nolabel="1"
                                       placeholder="Enter prohibited words or phrases, one per line..."/>
                            </group>
                        </page>

                        <!-- Tab 3: Godkännandekedja -->
                        <page string="Approval Chain" name="approval_chain">
                            <group name="approval_chain_group" string="Approval Steps">
                                <field name="approval_chain" widget="json"
                                       placeholder='[{"role": "creator", "action": "submit"}, {"role": "approver", "action": "approve"}]'
                                       options="{'mode': 'code'}"/>
                            </group>
                            <group name="response_group" string="Response Targets">
                                <field name="response_time_target"/>
                            </group>
                        </page>

                        <!-- Tab 4: Krisprotokoll -->
                        <page string="Crisis Protocol" name="crisis_protocol">
                            <group name="crisis_group" string="Crisis Response">
                                <field name="crisis_response_protocol" nolabel="1"
                                       placeholder="Escalation procedures, channel freeze protocols, contact persons, response times..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Communication Policy - Search View -->
    <record id="view_communication_policy_search" model="ir.ui.view">
        <field name="name">communication.policy.search</field>
        <field name="model">communication.policy</field>
        <field name="arch" type="xml">
            <search string="Search Policies">
                <field name="name"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="archived" string="Archived" domain="[('state','=','archived')]"/>
                <separator/>
                <filter name="my" string="My Policies" domain="[('owner_id','=',uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_by_owner" string="Owner" context="{'group_by':'owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Communication Policy - Kanban View -->
    <record id="view_communication_policy_kanban" model="ir.ui.view">
        <field name="name">communication.policy.kanban</field>
        <field name="model">communication.policy</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="version"/>
                <field name="state"/>
                <field name="owner_id"/>
                <field name="plan_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <span class="badge" t-att-class="state == 'active' and 'badge-success' or state == 'draft' and 'badge-warning' or 'badge-secondary'">
                                    <field name="state"/>
                                </span>
                                <span class="badge badge-info">v<field name="version"/></span>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <span><field name="plan_count"/> plan(s)</span>
                                <span class="float-right"><field name="owner_id"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_communication_policy" model="ir.actions.act_window">
        <field name="name">Communication Policies</field>
        <field name="res_model">communication.policy</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_communication_policy_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No communication policies found</p>
            <p>
                Create a communication policy to define how your organization communicates
                — tone of voice, brand voice, approval chains, and crisis protocols.
            </p>
        </field>
    </record>
</odoo>
