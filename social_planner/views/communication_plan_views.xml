<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Communication Plan - Tree View -->
    <record id="view_communication_plan_tree" model="ir.ui.view">
        <field name="name">communication.plan.tree</field>
        <field name="model">communication.plan</field>
        <field name="arch" type="xml">
            <tree string="Communication Plans"
                  decoration-warning="state == 'draft'"
                  decoration-muted="state == 'archived'"
                  decoration-success="state == 'completed'">
                <field name="name"/>
                <field name="policy_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active' or state == 'completed'"
                       decoration-warning="state == 'draft'"
                       decoration-muted="state == 'archived'"/>
                <field name="completion_percentage" widget="progressbar"/>
                <field name="line_count" string="Lines"/>
                <field name="post_count" string="Posts"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <!-- Communication Plan - Form View -->
    <record id="view_communication_plan_form" model="ir.ui.view">
        <field name="name">communication.plan.form</field>
        <field name="model">communication.plan</field>
        <field name="arch" type="xml">
            <form string="Communication Plan">
                <header>
                    <button name="action_draft" string="Set Draft" type="object"
                            states="active,completed,archived" class="btn-secondary"/>
                    <button name="action_activate" string="Activate" type="object"
                            states="draft,archived" class="btn-primary"/>
                    <button name="action_complete" string="Complete" type="object"
                            states="active" class="btn-success"/>
                    <button name="action_archive" string="Archive" type="object"
                            states="draft,active,completed" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,completed,archived"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Plan Name" required="1"/>
                        </h1>
                    </div>

                    <!-- Policy indicator -->
                    <div class="alert alert-info" role="alert" attrs="{'invisible': [('policy_id', '=', False)]}">
                        Policy: <field name="policy_id"/> —
                        Status: <field name="policy_state" widget="badge"/>
                        <field name="completion_percentage" widget="progressbar"/>
                    </div>

                    <group name="main_info">
                        <group name="left">
                            <field name="policy_id"
                                   domain="[('state', 'in', ['active', 'draft'])]"
                                   required="1"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="right">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Goals &amp; Audience" name="goals">
                            <group name="goal_group" string="Goals">
                                <field name="goal" nolabel="1"
                                       placeholder="Measurable goals: e.g. 'Increase reach by 25%, generate 50 leads'..."/>
                            </group>
                            <group name="audience_group" string="Target Audience">
                                <field name="target_audience" nolabel="1"
                                       placeholder="Describe your target audience..."/>
                            </group>
                            <group name="description_group" string="Description">
                                <field name="description" nolabel="1"
                                       placeholder="Overall description and purpose..."/>
                            </group>
                        </page>

                        <page string="Plan Lines" name="lines">
                            <field name="line_ids" nolabel="1"
                                   context="{'default_plan_id': active_id}"/>
                        </page>
                    </notebook>
                </sheet>

                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Communication Plan Line - Form View -->
    <record id="view_communication_plan_line_form" model="ir.ui.view">
        <field name="name">communication.plan.line.form</field>
        <field name="model">communication.plan.line</field>
        <field name="arch" type="xml">
            <form string="Plan Line">
                <header>
                    <button name="action_create_post" string="Create Post" type="object"
                            states="planned" class="btn-primary"
                            attrs="{'invisible': [('post_count', '&gt;', 0)]}"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            states="planned,in_progress" class="btn-secondary"/>
                    <button name="action_replan" string="Re-plan" type="object"
                            states="cancelled,completed" class="btn-secondary"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="planned,in_progress,completed,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="plan_id" invisible="1"/>
                            <field name="channel"/>
                            <field name="content_type"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="time" widget="float_time"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group string="Content">
                        <field name="theme"/>
                        <field name="notes"/>
                    </group>
                    <group string="Posts" attrs="{'invisible': [('post_count', '=', 0)]}">
                        <field name="post_ids" nolabel="1">
                            <tree>
                                <field name="display_name"/>
                                <field name="state"/>
                                <field name="approval_state"/>
                                <field name="scheduled_date"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Communication Plan Line - Tree View -->
    <record id="view_communication_plan_line_tree" model="ir.ui.view">
        <field name="name">communication.plan.line.tree</field>
        <field name="model">communication.plan.line</field>
        <field name="arch" type="xml">
            <tree string="Plan Lines" editable="bottom"
                  decoration-muted="status == 'cancelled'"
                  decoration-success="status == 'completed'">
                <field name="sequence" widget="handle"/>
                <field name="date"/>
                <field name="time" widget="float_time"/>
                <field name="channel" widget="badge"/>
                <field name="content_type"/>
                <field name="theme"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'completed'"
                       decoration-warning="status == 'in_progress'"
                       decoration-danger="status == 'cancelled'"/>
                <field name="post_count" string="Posts"/>
            </tree>
        </field>
    </record>

    <!-- Communication Plan - Kanban View -->
    <record id="view_communication_plan_kanban" model="ir.ui.view">
        <field name="name">communication.plan.kanban</field>
        <field name="model">communication.plan</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="policy_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="completion_percentage"/>
                <field name="line_count"/>
                <field name="post_count"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <field name="policy_id"/>
                                </div>
                                <div class="mt8">
                                    <span class="badge"
                                          t-att-class="state == 'active' and 'badge-success' or state == 'draft' and 'badge-warning' or state == 'completed' and 'badge-info' or 'badge-secondary'">
                                        <field name="state"/>
                                    </span>
                                </div>
                                <div class="mt8">
                                    <field name="completion_percentage" widget="progressbar"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div>
                                    <field name="start_date"/> → <field name="end_date"/>
                                </div>
                                <div class="text-muted">
                                    <field name="line_count"/> lines · <field name="post_count"/> posts
                                </div>
                                <span class="float-right"><field name="user_id"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Communication Plan - Calendar View -->
    <record id="view_communication_plan_calendar" model="ir.ui.view">
        <field name="name">communication.plan.calendar</field>
        <field name="model">communication.plan</field>
        <field name="arch" type="xml">
            <calendar string="Communication Plans" date_start="start_date" date_stop="end_date" color="color">
                <field name="name"/>
                <field name="user_id"/>
            </calendar>
        </field>
    </record>

    <!-- Communication Plan - Search View -->
    <record id="view_communication_plan_search" model="ir.ui.view">
        <field name="name">communication.plan.search</field>
        <field name="model">communication.plan</field>
        <field name="arch" type="xml">
            <search string="Search Plans">
                <field name="name"/>
                <field name="policy_id"/>
                <field name="user_id"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="completed" string="Completed" domain="[('state','=','completed')]"/>
                <filter name="archived" string="Archived" domain="[('state','=','archived')]"/>
                <separator/>
                <filter name="my" string="My Plans" domain="[('user_id','=',uid)]"/>
                <filter name="today" string="Active Today"
                        domain="[('start_date','&lt;=',context_today().strftime('%%Y-%%m-%%d')),('end_date','&gt;=',context_today().strftime('%%Y-%%m-%%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_by_policy" string="Policy" context="{'group_by':'policy_id'}"/>
                    <filter name="group_by_user" string="Responsible" context="{'group_by':'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_communication_plan" model="ir.actions.act_window">
        <field name="name">Communication Plans</field>
        <field name="res_model">communication.plan</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="search_view_id" ref="view_communication_plan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No communication plans yet</p>
            <p>
                Create a communication plan to organize your social media campaigns
                across multiple channels, guided by your communication policy.
            </p>
        </field>
    </record>
</odoo>
