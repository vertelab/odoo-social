<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend social_marketing.post form view with plan/policy fields and approval -->
    <record id="view_social_marketing_post_form_inherit" model="ir.ui.view">
        <field name="name">social_marketing.post.form.inherit</field>
        <field name="model">social_marketing.post</field>
        <field name="inherit_id" ref="social_marketing.social_marketing_post_view_form"/>
        <field name="arch" type="xml">
            <!-- Add AI generation + approval buttons inside existing header -->
            <xpath expr="//header" position="inside">
                <button name="action_ai_generate" string="✨ Generate with AI" type="object"
                        class="btn-info"
                        invisible="not policy_id or state not in ['draft']"
                        groups="social_planner.group_social_content_creator"
                        help="Generate post content using AI based on your communication policy and plan context."/>
                <button name="action_ai_suggest_hashtags" string="# Suggest Hashtags" type="object"
                        class="btn-secondary"
                        invisible="not policy_id or state not in ['draft']"
                        groups="social_planner.group_social_content_creator"/>
                <button name="action_submit_for_approval" string="Submit for Approval"
                        type="object" class="btn-primary"
                        invisible="not policy_id or approval_state not in ['draft', 'rejected']"
                        groups="social_planner.group_social_content_creator"/>
                <button name="action_approve" string="Approve" type="object"
                        class="btn-success"
                        invisible="approval_state != 'pending_approval'"
                        groups="social_planner.group_social_content_approver"/>
                <button name="action_reject" string="Reject" type="object"
                        class="btn-danger"
                        invisible="approval_state != 'pending_approval'"
                        groups="social_planner.group_social_content_approver"
                        confirm="Are you sure you want to reject this post? You can add a reason below."/>
                <field name="approval_state" widget="badge"
                       decoration-success="approval_state == 'approved'"
                       decoration-warning="approval_state == 'pending_approval'"
                       decoration-danger="approval_state == 'rejected'"
                       invisible="not policy_id"/>
            </xpath>

            <!-- Add plan/policy fields after the header in the sheet -->
            <xpath expr="//sheet//group[1]" position="before">
                <div class="alert alert-info" role="alert"
                     invisible="not plan_line_id">
                    <strong>Communication Plan:</strong>
                    <field name="plan_id" readonly="1"/>
                    ⇒ <field name="plan_line_id" readonly="1"/>
                    <br/>
                    <strong>Policy:</strong>
                    <field name="policy_id" readonly="1"/>
                    <span invisible="compliance_check_passed">
                        <field name="compliance_check_passed" invisible="1"/>
                        <span class="badge badge-danger">⚠ Compliance issues</span>
                    </span>
                    <span invisible="compliance_check_passed or not compliance_warnings">
                        <field name="compliance_warnings" readonly="1"/>
                    </span>
                </div>
            </xpath>

            <!-- Add plan_line_id, reviewer, rejection_reason fields -->
            <xpath expr="//sheet//notebook" position="inside">
                <page string="Plan &amp; Policy" name="plan_policy"
                      invisible="not plan_line_id">
                    <group>
                        <group>
                            <field name="plan_line_id"/>
                            <field name="reviewer_id"/>
                        </group>
                        <group>
                            <field name="rejection_reason"
                                   invisible="approval_state != 'rejected'"/>
                            <field name="compliance_check_passed" widget="boolean_toggle"/>
                            <field name="compliance_warnings"
                                   invisible="not compliance_warnings"/>
                        </group>
                    </group>
                    <group string="AI Generation" invisible="not ai_generated">
                        <field name="ai_generated"/>
                        <field name="ai_prompt"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_social_marketing_post_form_pipeline_snapshot" model="ir.ui.view">
        <field name="name">social_marketing.post.form.pipeline.snapshot</field>
        <field name="model">social_marketing.post</field>
        <field name="inherit_id" ref="social_planner.view_social_marketing_post_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='plan_policy']//group[1]" position="after">
                <group string="Compliance Snapshot"
                       invisible="not compliance_snapshot">
                    <group>
                        <field name="compliance_snapshot" readonly="1"
                               widget="jsonb"/>
                        <field name="compliance_checked_at" readonly="1"/>
                    </group>
                    <group>
                        <field name="needs_recheck" readonly="1"/>
                        <field name="compliance_recheck_verdict" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
