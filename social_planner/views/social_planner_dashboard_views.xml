<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Social Planner Dashboard -->
    <record id="view_social_planner_dashboard" model="ir.ui.view">
        <field name="name">social.planner.dashboard</field>
        <field name="model">social.planner.dashboard</field>
        <field name="arch" type="xml">
            <form string="Social Planner Dashboard">
                <sheet>
                    <h1 class="text-center mt16 mb16">Social Planner Dashboard</h1>

                    <div class="row">
                        <!-- Active Plans -->
                        <div class="col-12 col-lg-6">
                            <div class="card">
                                <div class="card-header"><strong>Active Plans</strong></div>
                                <div class="card-body">
                                    <field name="active_plan_ids" nolabel="1">
                                        <kanban class="o_kanban_mobile">
                                            <templates>
                                                <t t-name="card">
                                                    <div>
                                                        <strong><field name="name"/></strong>
                                                        <div>
                                                            <field name="completion_percentage" widget="progressbar"/>
                                                        </div>
                                                        <div class="text-muted">
                                                            <field name="start_date"/> → <field name="end_date"/>
                                                        </div>
                                                    </div>
                                                </t>
                                            </templates>
                                        </kanban>
                                    </field>
                                </div>
                            </div>
                        </div>

                        <!-- Unread Inbox -->
                        <div class="col-12 col-lg-6">
                            <div class="card">
                                <div class="card-header"><strong>Unread Messages</strong></div>
                                <div class="card-body">
                                    <field name="unread_message_ids" nolabel="1">
                                        <list>
                                            <field name="from_name"/>
                                            <field name="body"/>
                                            <field name="media_type" widget="badge"/>
                                            <field name="create_date" widget="relative_time"/>
                                        </list>
                                    </field>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt16">
                        <!-- Pending Approvals -->
                        <div class="col-12 col-lg-6">
                            <div class="card">
                                <div class="card-header"><strong>Pending Approvals</strong></div>
                                <div class="card-body">
                                    <field name="pending_approval_ids" nolabel="1">
                                        <list>
                                            <field name="display_name"/>
                                            <field name="plan_id"/>
                                            <field name="create_date" widget="relative_time"/>
                                        </list>
                                    </field>
                                </div>
                            </div>
                        </div>

                        <!-- Top Competitors -->
                        <div class="col-12 col-lg-6">
                            <div class="card">
                                <div class="card-header"><strong>Top Competitors</strong></div>
                                <div class="card-body">
                                    <field name="top_competitor_ids" nolabel="1">
                                        <list>
                                            <field name="name"/>
                                            <field name="media_type" widget="badge"/>
                                            <field name="follower_count"/>
                                            <field name="engagement_rate"/>
                                            <field name="follower_trend" widget="float_time"/>
                                        </list>
                                    </field>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt16">
                        <!-- Recent Posts -->
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header"><strong>Recent Posts</strong></div>
                                <div class="card-body">
                                    <field name="recent_post_ids" nolabel="1">
                                        <list>
                                            <field name="display_name"/>
                                            <field name="state" widget="badge"/>
                                            <field name="approval_state" widget="badge"/>
                                            <field name="create_date" widget="relative_time"/>
                                        </list>
                                    </field>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="action_social_planner_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">social.planner.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_social_planner_dashboard"/>
        <field name="target">current</field>
    </record>
</odoo>
